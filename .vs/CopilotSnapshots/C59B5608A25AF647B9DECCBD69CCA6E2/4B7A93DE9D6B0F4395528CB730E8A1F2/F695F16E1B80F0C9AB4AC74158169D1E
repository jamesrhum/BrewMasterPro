using BrewMaster.Core.Models;
using BrewMaster.Core.Services;

namespace BrewMaster.Tests
{
    public class OrderServiceTests
    {
        [Fact]
        public void AddItem_AddsItemToItemsList()
        {
            // Arrange
            var service = new OrderService();
            var item = new Food(1, "Sandwich", 5.50m, true);

            // Act
            service.AddItem(item);

            // Assert
            Assert.Single(service.Items);
            Assert.Contains(item, service.Items);
        }

        [Fact]
        public void AddItem_ThrowsArgumentException_WhenPriceIsNegative()
        {
            // Arrange
            var service = new OrderService();

            // Act & Assert
            Assert.Throws<ArgumentException>(() => service.AddItem(new Food(1, "Freebie", -1.00m, false)));
        }

        [Fact]
        public void GetHighCaffeineDrinks_ReturnsOnlyHighCaffeine_IgnoringCase()
        {
            // Arrange
            var service = new OrderService();
            var high = new Drink(1, "Espresso", 3.00m, "High");
            var highCaps = new Drink(2, "Cold Brew", 4.00m, "HIGH");
            var low = new Drink(3, "Decaf", 2.50m, "Low");

            service.AddItem(high);
            service.AddItem(highCaps);
            service.AddItem(low);

            // Act
            var result = service.GetHighCaffeineDrinks().ToList();

            // Assert
            Assert.Equal(2, result.Count);
            Assert.Contains(high, result);
            Assert.Contains(highCaps, result);
        }

        [Fact]
        public void GetOrderSummary_ReturnsCorrectCountAndTotal()
        {
            // Arrange
            var service = new OrderService();
            service.AddItem(new Food(1, "Bagel", 2.25m, false));
            service.AddItem(new Drink(2, "Latte", 3.75m, "Medium"));

            // Act
            var (count, total) = service.GetOrderSummary();

            // Assert
            Assert.Equal(2, count);
            Assert.Equal(6.00m, total);
        }
    }
}