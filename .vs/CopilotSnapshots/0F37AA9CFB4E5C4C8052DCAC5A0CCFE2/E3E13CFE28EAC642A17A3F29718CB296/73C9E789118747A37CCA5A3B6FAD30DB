namespace BrewMaster.Library.Models
{
    public abstract class MenuItem
    {
        public int Id { get; }
        public string Name { get; } = string.Empty;
        public decimal BasePrice { get; }

        public MenuItem(int id, string name, decimal basePrice)
        {
            if(id <=0) throw new ArgumentOutOfRangeException("Id must be greater than 0");
            if(string.IsNullOrWhiteSpace(name)) throw new ArgumentException("Name must not be null, empty, or whitespace");
            if(basePrice < 0) throw new ArgumentOutOfRangeException("BasePrice must must not be negative");
            Id = id;
            Name = name;
            BasePrice = basePrice;
        }

        public virtual string GetReceiptLine()
        {
            return $"Item:{Name} - (${BasePrice:F2})";
        }
    }
}